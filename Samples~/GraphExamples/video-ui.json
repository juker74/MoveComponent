{
  "schemaVersion": 1,
  "id": "video-ui-demo",
  "name": "多帧 UI 与动态分支示例",
  "nodes": [
    {
      "id": "video-a",
      "typeId": "media.video",
      "title": "视频：两个触发帧",
      "x": 100,
      "y": 100,
      "properties": {
        "source": "movecomponent-preview",
        "volume": 1,
        "frames": [
          10,
          40
        ]
      }
    },
    {
      "id": "ui-choice",
      "typeId": "media.ui",
      "title": "选项 UI：暂停视频",
      "x": 600,
      "y": 100,
      "properties": {
        "uiType": "Game.UI.ChoiceUI, Assembly-CSharp",
        "parameters": {
          "options": [
            "开门",
            "离开"
          ]
        },
        "pauseVideo": true,
        "branches": [
          {
            "id": "open",
            "name": "开门"
          },
          {
            "id": "leave",
            "name": "离开"
          }
        ]
      }
    },
    {
      "id": "ui-hint",
      "typeId": "media.ui",
      "title": "提示 UI：继续播放",
      "x": 600,
      "y": 400,
      "properties": {
        "uiType": "Game.UI.HintUI, Assembly-CSharp",
        "parameters": {
          "text": "发现线索"
        },
        "pauseVideo": false,
        "branches": [
          {
            "id": "continue",
            "name": "继续"
          }
        ]
      }
    },
    {
      "id": "video-open",
      "typeId": "media.video",
      "title": "开门后的视频",
      "x": 1100,
      "y": 100,
      "properties": {
        "source": "movecomponent-preview",
        "volume": 1,
        "frames": []
      }
    },
    {
      "id": "video-leave",
      "typeId": "media.video",
      "title": "离开后的视频",
      "x": 1100,
      "y": 400,
      "properties": {
        "source": "movecomponent-preview",
        "volume": 1,
        "frames": []
      }
    }
  ],
  "edges": [
    {
      "id": "frame10-choice",
      "sourceNodeId": "video-a",
      "sourcePortId": "frame:10",
      "targetNodeId": "ui-choice",
      "targetPortId": "enter",
      "order": 0
    },
    {
      "id": "frame40-hint",
      "sourceNodeId": "video-a",
      "sourcePortId": "frame:40",
      "targetNodeId": "ui-hint",
      "targetPortId": "enter",
      "order": 0
    },
    {
      "id": "choice-open",
      "sourceNodeId": "ui-choice",
      "sourcePortId": "branch:open",
      "targetNodeId": "video-open",
      "targetPortId": "enter",
      "order": 0
    },
    {
      "id": "choice-leave",
      "sourceNodeId": "ui-choice",
      "sourcePortId": "branch:leave",
      "targetNodeId": "video-leave",
      "targetPortId": "enter",
      "order": 0
    }
  ]
}
