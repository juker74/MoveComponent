{
  "schemaVersion": 1,
  "id": "example-cycle",
  "name": "数据与控制环路示例",
  "nodes": [
    {
      "id": "a",
      "typeId": "common.text",
      "title": "文本 A",
      "x": 100,
      "y": 100,
      "properties": {
        "value": "Hello"
      }
    },
    {
      "id": "b",
      "typeId": "common.text",
      "title": "文本 B",
      "x": 520,
      "y": 260,
      "properties": {
        "value": "World"
      }
    }
  ],
  "edges": [
    {
      "id": "ab",
      "sourceNodeId": "a",
      "sourcePortId": "valueOut",
      "targetNodeId": "b",
      "targetPortId": "valueIn",
      "order": 0
    },
    {
      "id": "ba",
      "sourceNodeId": "b",
      "sourcePortId": "next",
      "targetNodeId": "a",
      "targetPortId": "enter",
      "order": 0
    }
  ]
